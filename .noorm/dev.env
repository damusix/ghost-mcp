# noorm connection to the dockerized Ghost MySQL (env-only mode).
#
#   set -a; source .noorm/dev.env; set +a
#   noorm db explore
#
# Matches the credentials and host port in docker-compose.yml. Local-dev only.
# If you started the stack with a custom MYSQL_PORT, override NOORM_CONNECTION_PORT.

export NOORM_CONNECTION_DIALECT=mysql
export NOORM_CONNECTION_HOST=127.0.0.1
export NOORM_CONNECTION_PORT=3306
export NOORM_CONNECTION_DATABASE=ghost
export NOORM_CONNECTION_USER=root
export NOORM_CONNECTION_PASSWORD=ghost
